# Copy this file to .env and fill in your own credentials.
# Do not commit .env because it contains secrets.

# X/Twitter API bearer token, used for fetching public tweets.
X_BEARER_TOKEN=your_x_bearer_token_here

# DeepSeek/OpenAI-compatible API settings, used for translation and AI analysis.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Optional per-model prices used only for local cost estimates. Values are USD
# per one million input/output tokens. No provider prices are hard-coded.
# LLM_PRICING_JSON={"deepseek-chat":{"input_per_million":0.0,"output_per_million":0.0}}

# Optional OpenAI-compatible fallback used by analyze_pro.py
# 如果不设置，analyze_pro.py 会使用 DeepSeek 配置
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Target X/Twitter username without @.
TARGET_USERNAME=MiracleHe

# Incremental history fetch target date.
TARGET_DATE=2024-01-01

# Local timezone offset for behavior and visualization reports.
# China: 8, Japan/Korea: 9.
TIMEZONE_OFFSET=8
